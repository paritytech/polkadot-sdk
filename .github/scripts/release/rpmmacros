# Template for ~/.rpmmacros used when signing RPMs in CI.
#
# rpm needs an absolute path for %__gpg/%__gpgbin, and that path must not
# hardcode the repository name: GITHUB_WORKSPACE already points at the checkout
# and is substituted into this template at runtime by the release workflow
# (.github/workflows/release-reusable-publish-packages.yml).
%_signature gpg
%_gpg_name 90BD75EBBB8E95CB3DA6078F94A4029AB4B35DAE
%__gpg ${GITHUB_WORKSPACE}/.github/scripts/release/pgpkms-gpg-wrapper.sh
%__gpgbin ${GITHUB_WORKSPACE}/.github/scripts/release/pgpkms-gpg-wrapper.sh
