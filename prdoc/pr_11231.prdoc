title: 'relay_chain: add max_relay_parent_age runtime API and HostConfiguration field'
doc:
- audience: [Runtime Dev, Node Dev]
  description: |
    Adds a new `max_relay_parent_age` field to `HostConfiguration` and runtime API,
    representing the maximum age of a relay parent that a parachain block can build upon,
    measured in relay chain blocks.

    Includes a storage migration (v12 -> v13) that initialises the new field to the current
    `scheduling_lookahead` value.

migrations:
  runtime:
  - reference: polkadot-runtime-parachains
    description: |
      v12 -> v13 configuration migration. Adds the `max_relay_parent_age` field to
      `SchedulerParams`, initialised to the existing `scheduling_lookahead` value.

crates:
- name: polkadot-primitives
  bump: minor
- name: polkadot-runtime-parachains
  bump: major
- name: polkadot-node-subsystem-types
  bump: major
- name: polkadot-node-core-runtime-api
  bump: minor
- name: westend-runtime
  bump: major
- name: rococo-runtime
  bump: major
- name: polkadot-test-runtime
  bump: minor
- name: polkadot-test-service
  bump: patch
- name: cumulus-relay-chain-rpc-interface
  bump: minor
- name: cumulus-relay-chain-minimal-node
  bump: minor
- name: pallet-staking-async-rc-runtime
  bump: patch
