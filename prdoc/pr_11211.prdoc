title: fix(bridge-hub): expose try-runtime feature in bridge-hub-test-utils

doc:
  audience: Node Dev
  description: |
    Fixes #10962

    **Summary**  
    When running `cargo test --features try-runtime` (or `--all-features`) on BridgeHub runtimes, compilation failed with:

    ```
    error[E0046]: not all trait items implemented, missing: `try_successful_origin`
     --> .../assets-common-.../foreign_creators.rs:29:1
    ```

crates:
  - name: bridge-hub-rococo-runtime
    bump: patch
  - name: bridge-hub-westend-runtime
    bump: patch
  - name: bridge-hub-test-utils
    bump: patch
