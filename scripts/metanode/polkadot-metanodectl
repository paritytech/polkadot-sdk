#!/usr/bin/env bash
# polkadot-metanodectl: operator helpers of the metanode systemd units.
#
# The role units (polkadot-<role>.service) run the nodes themselves, with the commands of
# operators/setup.md and the variables of /etc/polkadot-metanode/metanode.env; nothing here runs when
# a node starts. This tool checks the machine and the configuration, reports on the nodes, generates
# session keys and reserves the validator's bandwidth. See scripts/metanode/README.md.
#
# Usage:
#   polkadot-metanodectl status                       summarise every installed role on this machine
#   polkadot-metanodectl doctor [<role>...]           check this machine and its configuration
#   polkadot-metanodectl rotate-keys <role> <stash>   generate session keys owned by <stash>
#   polkadot-metanodectl qos start|stop|reload|status|check
#                                                     reserve uplink bandwidth for the validator
#   polkadot-metanodectl network-env <network>        the chains of a network, as metanode.env lines
#   polkadot-metanodectl check-config <file>          check the variables of a metanode.env
#   polkadot-metanodectl fetch-specs <network> <dir>  download and verify a network's chain specs
#
# Roles: validator, asset-hub-collator (or asset-hub), people-collator (or people).
set -euo pipefail

# The role table: binary, ports and chain variable of every role, the layout of operators/setup.md.
# The units pass the same ports to their nodes (tests/run.sh lint checks that they agree); the
# README's ports table shows them too. "-": the role has no relay side. The relay RPC port is only
# used by an embedded relay chain node.
#
# role               binary             p2p    relay-p2p rpc   unsafe-rpc relay-rpc prometheus relay-prometheus chain
ROLE_TABLE='
validator          polkadot           30333  -         9944  9945       -         9615       -                RELAY_CHAIN
asset-hub-collator polkadot-parachain 30334  30335     9946  9947       9950      9616       9617             ASSET_HUB_CHAIN
people-collator    polkadot-parachain 30336  30337     9948  9949       9951      9618       9619             PEOPLE_CHAIN
'
ROLES=(validator asset-hub-collator people-collator)

# The chains of every network, by part (the validator runs the relay chain), and their genesis
# hashes. A chain is a built-in id of the binaries or @<file>: a spec that install.sh downloads into
# the spec directory, see CHAIN_SPEC_TABLE. Paseo's specs are downloaded because the binaries'
# built-in `paseo` is an older network than the live one (genesis 0x77af... instead of 0x3740...).
# The genesis hashes come from the binaries (export-genesis-head, chain_getBlockHash 0) and, for
# Paseo, from the live chains.
#
# network part      chain                            genesis
NETWORK_TABLE='
polkadot  relay     polkadot                         0x91b171bb158e2d3848fa23a9f1c25182fb8e20313b2c1eb49219da7a70ce90c3
polkadot  asset-hub asset-hub-polkadot               0x68d56f15f85d3136970ec16946040bc1752654e906147f7e43e9d539d7c3de2f
polkadot  people    people-polkadot                  0x67fa177a097bfa18f77ea95ab56e9bcdfeb0e5b8a40e46298bb93e16b6fc5008
kusama    relay     kusama                           0xb0a8d493285c2df73290dfb7e61f870f17b41801197a149ca93654499ea3dafe
kusama    asset-hub asset-hub-kusama                 0x48239ef607d7928874027a43a67689209727dfb3d3dc5e5b03a39bdc2eda771a
kusama    people    people-kusama                    0xc1af4cb4eb3918e5db15086c0cc5ec17fb334f728b7c65dd44bfe1e174ff8b3f
westend   relay     westend                          0xe143f23803ac50e8f6f8e62695d1ce9e4e1d68aa36c1cd2cfd15340213f3423e
westend   asset-hub asset-hub-westend                0x67f9723393ef76214df0118c34bbbd3dbebc8ed46a10973a8c969d48fe7598c9
westend   people    people-westend                   0x1eb6fb0ba5187434de017a70cb84d4f47142df1d571d0ef9e7e1407f2b80b93c
paseo     relay     @paseo/paseo.json                0x374057be67b355151f271ff70c3db98308c62c8adc48dc6724b6a009a1a014fd
paseo     asset-hub @paseo/asset-hub-next-paseo.json 0x4349b00e54897e21196fd331015fc5be0f14e118beb0375ed2bb1793737bb57a
paseo     people    @paseo/people-next-paseo.json    0x4a2b5b737de1da59e209b0000a876ec2fa20035dc34fd292a848da32d255ad48
'
NETWORKS=(polkadot kusama westend paseo)

# The chain specs install.sh downloads: file in the spec directory, source and sha256. Paseo runs the
# metanode system chains Asset Hub Next (para 1500) and People Next (para 1502). The parachain specs
# come from the chainspecs repository: its paritytech.github.io copies are outdated (wrong genesis).
# A changed upstream file fails the download until its sha256 here is reviewed and updated.
#
# file                             url sha256
CHAIN_SPEC_TABLE='
paseo/paseo.json                 https://paritytech.github.io/chainspecs/paseo/relaychain/chainspec.json 73d2c6f5571c10f26a4bdc169802761457e42e8f75286ab902939414f416b09b
paseo/asset-hub-next-paseo.json  https://raw.githubusercontent.com/paritytech/chainspecs/main/paseo/parachain/asset-hub-next/raw.json c2dbbe3daddf302e2c126a8ffbe26897f4c8d70982697055f9d3c576274465fb
paseo/people-next-paseo.json     https://raw.githubusercontent.com/paritytech/chainspecs/main/paseo/parachain/people-next-system/raw.json 118146dad6ce383d15222fb71eb41a6bfba98b6f7c69b23a1c2ce36c4d6bd375
'

# The variables of metanode.env and of the units' own files (polkadot-<role>.env). PUBLIC_ADDRS is
# not one: public-addr writes it when a role starts.
VARIABLES=(NETWORK RELAY_CHAIN ASSET_HUB_CHAIN PEOPLE_CHAIN RELAY_CHAIN_RPC_URLS PUBLIC_IP RPC_LISTEN_IP
  RPC_MAX_CONNECTIONS SYNC NODE_NAME EXTRA_ARGS RELAY_EXTRA_ARGS UPLINK_RATE UPLINK_DEVICE
  VALIDATOR_UPLINK_MBIT)

CONF_DIR=${POLKADOT_METANODE_CONF_DIR:-/etc/polkadot-metanode}
# Every layout (install.sh, a package) installs this tool next to polkadot and polkadot-parachain,
# and its own files (public-addr, the downloaded chain specs) in lib/polkadot-metanode next to its
# bin directory, where the units look for them too (@BINDIR@ and @LIBDIR@ in the unit templates).
SELF_DIR=$(dirname "$(readlink -f "$0")")
BIN_DIR=$SELF_DIR
LIB_DIR=${POLKADOT_METANODE_LIB_DIR:-$(dirname "$SELF_DIR")/lib/polkadot-metanode}
SPEC_DIR=$LIB_DIR/chain-specs
# The validator's user. The bandwidth reservation tags its packets by this user.
VALIDATOR_USER=polkadot-validator
# check-config exits with EX_CONFIG for an invalid file.
EX_CONFIG=78

die() {
  echo "polkadot-metanodectl: $*" >&2
  exit 1
}

warn() {
  echo "polkadot-metanodectl: warning: $*" >&2
}

usage() {
  cat >&2 <<EOF
Usage:
  polkadot-metanodectl status                       summarise every installed role on this machine
  polkadot-metanodectl doctor [<role>...]           check this machine and its configuration
                                                    (default: the roles enabled here, else all)
  polkadot-metanodectl rotate-keys <role> <stash>   generate session keys owned by <stash>
  polkadot-metanodectl qos start|stop|reload|status|check
                                                    reserve uplink bandwidth for the validator
                                                    (UPLINK_RATE in metanode.env)
  polkadot-metanodectl network-env <network>        the chains of a network, as metanode.env lines
  polkadot-metanodectl check-config <file>          check the variables of a metanode.env
  polkadot-metanodectl fetch-specs <network> <dir>  download and verify a network's chain specs

Roles: ${ROLES[*]} (also asset-hub, people).
Configuration: $CONF_DIR/metanode.env, and $CONF_DIR/polkadot-<role>.env for one machine.
EOF
  exit "${1:-2}"
}

# The role names operators type most: asset-hub and people mean the collators.
canonical_role() {
  case "$1" in
    asset-hub) echo asset-hub-collator ;;
    people) echo people-collator ;;
    *) echo "$1" ;;
  esac
}

# role_row <role>: sets ROLE, the ports and CHAIN_VAR from the role's row of the role table.
role_row() {
  ROLE=$(canonical_role "$1")
  local role p2p relay_p2p rpc unsafe_rpc relay_rpc prometheus relay_prometheus chain
  while read -r role _ p2p relay_p2p rpc unsafe_rpc relay_rpc prometheus relay_prometheus chain; do
    [ "$role" = "$ROLE" ] || continue
    P2P_PORT=$p2p RELAY_P2P_PORT=$relay_p2p RPC_PORT=$rpc RPC_UNSAFE_PORT=$unsafe_rpc
    RELAY_RPC_PORT=$relay_rpc PROMETHEUS_PORT=$prometheus RELAY_PROMETHEUS_PORT=$relay_prometheus
    CHAIN_VAR=$chain
    return 0
  done <<<"$ROLE_TABLE"
  die "unknown role '$ROLE' (expected one of: ${ROLES[*]})"
}

# The part of a network a role runs: relay for the validator, else the collator's chain.
role_part() {
  case "$1" in
    validator) echo relay ;;
    *) echo "${1%-collator}" ;;
  esac
}

# The variable of metanode.env that holds the chain of a part.
part_var() {
  case "$1" in
    relay) echo RELAY_CHAIN ;;
    asset-hub) echo ASSET_HUB_CHAIN ;;
    people) echo PEOPLE_CHAIN ;;
  esac
}

valid_network() {
  [[ " ${NETWORKS[*]} " == *" $1 "* ]]
}

# network_chain <network> <part>: prints "<chain> <genesis>" of the network's part, if the table has
# it, with a downloaded spec (@<file>) as its installed path.
network_chain() {
  local network part chain genesis
  while read -r network part chain genesis; do
    if [ "$network" = "$1" ] && [ "$part" = "$2" ]; then
      [[ "$chain" != @* ]] || chain=$SPEC_DIR/${chain#@}
      echo "$chain $genesis"
      return 0
    fi
  done <<<"$NETWORK_TABLE"
  return 1
}

# The lines of metanode.env that select a network: NETWORK and the chain of each part.
network_env() {
  local part net
  valid_network "$1" || die "unknown network '$1' (expected one of: ${NETWORKS[*]})"
  echo "NETWORK=$1"
  for part in relay asset-hub people; do
    net=$(network_chain "$1" "$part")
    echo "$(part_var "$part")=${net% *}"
  done
}

# ---- configuration ------------------------------------------------------------------------------

# The variables a unit passes to its node, filled by load_role_env (or one file, by load_env_file).
declare -A VARS=()

# load_env_file <file>: adds the file's variables to VARS, replacing earlier values, the way systemd
# reads an EnvironmentFile=: blank lines and lines starting with # or ; are skipped, the whitespace
# around a value is trimmed, and a pair of quotes around it removed.
load_env_file() {
  local line key value
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line#"${line%%[![:space:]]*}"}
    case "$line" in "" | "#"* | ";"*) continue ;; esac
    [[ "$line" == *=* ]] || continue
    key=${line%%=*} value=${line#*=}
    key=${key%"${key##*[![:space:]]}"}
    value=${value#"${value%%[![:space:]]*}"}
    value=${value%"${value##*[![:space:]]}"}
    if [[ "$value" =~ ^\"(.*)\"$ || "$value" =~ ^\'(.*)\'$ ]]; then value=${BASH_REMATCH[1]}; fi
    VARS[$key]=$value
  done <"$1"
}

# load_unit_environment <unit>: adds the unit's Environment= settings, its drop-ins' included, to
# VARS. systemctl prints them on one line, separated by spaces, and double-quotes a setting with
# spaces or special characters, escaping ", \, ` and $ in it with a backslash.
load_unit_environment() {
  local line c i word='' started=0 quoted=0
  line=$(systemctl show -p Environment --value "$1" 2>/dev/null) || return 0
  for ((i = 0; i < ${#line}; i++)); do
    c=${line:i:1}
    if [ "$quoted" = 1 ]; then
      case "$c" in
        \\) i=$((i + 1)) && word+=${line:i:1} ;;
        '"') quoted=0 ;;
        *) word+=$c ;;
      esac
    elif [ "$c" = '"' ]; then
      quoted=1 started=1
    elif [ "$c" = ' ' ]; then
      if [ "$started" = 1 ]; then VARS[${word%%=*}]=${word#*=}; fi
      word='' started=0
    else
      word+=$c started=1
    fi
  done
  if [ "$started" = 1 ]; then VARS[${word%%=*}]=${word#*=}; fi
}

# load_role_env <role>: fills VARS with the variables the role's unit passes to its node, as systemd
# computes them: the unit's Environment= settings (its defaults and any drop-in's), then its
# EnvironmentFile= files in order, each overriding what came before.
load_role_env() {
  local unit=polkadot-$1.service line file
  VARS=()
  systemctl cat "$unit" >/dev/null 2>&1 || die "$unit is not installed; run install.sh"
  load_unit_environment "$unit"
  while IFS= read -r line; do
    file=${line% (ignore_errors=*}
    if [ -n "$file" ] && [ -r "$file" ]; then load_env_file "$file"; fi
  done < <(systemctl show -p EnvironmentFiles --value "$unit" 2>/dev/null)
}

# env_file_errors <file>: the lines systemd would not read as KEY=value.
env_file_errors() {
  local line trimmed n=0
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    trimmed=${line#"${line%%[![:space:]]*}"}
    case "$trimmed" in "" | "#"* | ";"*) continue ;; esac
    [[ "$trimmed" =~ ^[A-Za-z_][A-Za-z0-9_]*[[:space:]]*= ]] || echo "line $n is not KEY=value: $line"
  done <"$1"
}

# valid_ip <address>: an IPv4 address in dotted quads, or something that looks like IPv6.
valid_ip() {
  local a b c d
  if [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    IFS=. read -r a b c d <<<"$1"
    ((a <= 255 && b <= 255 && c <= 255 && d <= 255))
  else
    [[ "$1" =~ ^[0-9a-fA-F:]+$ && "$1" == *:*:* ]]
  fi
}

# check_value <key> <value>: prints what is wrong with a variable's value, if anything.
check_value() {
  local key=$1 value=$2 word
  case "$key" in
    NETWORK)
      [ -z "$value" ] || valid_network "$value" || echo "unknown network '$value' (${NETWORKS[*]})"
      ;;
    RELAY_CHAIN | ASSET_HUB_CHAIN | PEOPLE_CHAIN)
      # An empty --chain is not refused by the nodes: polkadot takes it for Polkadot.
      case "$value" in
        "") echo "is empty; install.sh --network NAME sets it" ;;
        /*) ;;
        *)
          [[ "$value" =~ ^[a-z0-9][a-z0-9-]*$ ]] ||
            echo "'$value' is neither a chain id built into the binaries nor an absolute path to a chain spec"
          ;;
      esac
      ;;
    RELAY_CHAIN_RPC_URLS)
      for word in $value; do
        case "$word" in
          ws://* | wss://*) ;;
          *) echo "'$word' is not a ws:// or wss:// URL" ;;
        esac
      done
      ;;
    PUBLIC_IP)
      case "$value" in
        auto | none) ;;
        "") echo "is empty (auto, none, or the addresses to advertise)" ;;
        *)
          for word in $value; do
            valid_ip "$word" || echo "'$word' is not an IPv4 or IPv6 address (or auto, or none)"
          done
          ;;
      esac
      ;;
    RPC_LISTEN_IP)
      if [[ "$value" =~ ^\[(.*)\]$ ]]; then
        [[ "${BASH_REMATCH[1]}" == *:* ]] && valid_ip "${BASH_REMATCH[1]}" || echo "'$value' is not an IPv6 address"
      else
        [[ "$value" != *:* ]] && valid_ip "$value" ||
          echo "'$value' is not an IPv4 address, nor an IPv6 address in brackets such as [::]"
      fi
      ;;
    RPC_MAX_CONNECTIONS)
      [[ "$value" =~ ^[1-9][0-9]*$ ]] || echo "'$value' is not a number of connections"
      ;;
    SYNC)
      case "$value" in
        warp | full | fast | fast-unsafe) ;;
        *) echo "'$value' must be warp, full, fast or fast-unsafe" ;;
      esac
      ;;
    NODE_NAME)
      [ -n "$value" ] || echo "is empty"
      [[ "$value" != *[.@\\]* ]] || echo "'$value' contains '.', '@' or a backslash, which node names may not"
      ;;
    UPLINK_RATE)
      [ -z "$value" ] || qos_mbit "$value" >/dev/null || echo "'$value' must look like 1gbit, 2.5gbit or 1000mbit"
      ;;
    VALIDATOR_UPLINK_MBIT)
      [[ "$value" =~ ^[1-9][0-9]*$ ]] || echo "'$value' is not a number of Mbit/s"
      ;;
  esac
}

# The variables in VARS that no unit uses: typos, most likely.
unknown_variables() {
  local key
  for key in "${!VARS[@]}"; do
    [[ " ${VARIABLES[*]} PUBLIC_ADDRS " == *" $key "* ]] || echo "$key"
  done | sort
}

# Flags that may be given several times, so EXTRA_ARGS may add to those of the unit.
REPEATABLE_FLAGS=' --experimental-rpc-endpoint --relay-chain-rpc-urls --relay-chain-rpc-url --public-addr
  --bootnodes --reserved-nodes --listen-addr '
# RPC flags that do not apply to the endpoints the units configure.
RPC_FLAGS=' --rpc-port --rpc-external --unsafe-rpc-external --rpc-methods --rpc-cors
  --rpc-max-connections '

# unit_flags <unit> <node|relay>: the flags the unit's command passes to its node, or after "--" to
# a collator's relay chain node, one per line, without their values.
unit_flags() {
  local argv word side=node
  argv=$(systemctl show -p ExecStart --value "$1" 2>/dev/null | sed -n 's/.* argv\[\]=\([^;]*\) ;.*/\1/p')
  for word in $argv; do
    if [ "$word" = -- ]; then
      side=relay
    elif [[ "$word" == --* && "$side" = "$2" ]]; then
      echo "${word%%=*}"
    fi
  done
}

# extra_args_problems <unit> <node|relay> <key>: an extra flag may not repeat one the unit already
# passes (the node refuses to start), nor be an RPC flag, which would not apply to its endpoints.
extra_args_problems() {
  local passed arg flag
  passed=" $(unit_flags "$1" "$2" | tr '\n' ' ') "
  for arg in ${VARS[$3]:-}; do
    flag=${arg%%=*}
    [[ "$flag" == --* ]] || continue
    if [[ "$passed" == *" $flag "* && "$REPEATABLE_FLAGS" != *[[:space:]]"$flag"[[:space:]]* ]]; then
      echo "$3 repeats $flag, which $1 already passes; replace its ExecStart instead (README.md, \"Configure\")"
    elif [ "$2" = node ] && [[ "$RPC_FLAGS" == *[[:space:]]"$flag"[[:space:]]* ]]; then
      echo "$3 sets $flag, which does not apply to the RPC endpoints; use RPC_LISTEN_IP and RPC_MAX_CONNECTIONS"
    fi
  done
}

# config_problems <role>: prints what is wrong with the variables of the role's unit (VARS, from
# load_role_env), one problem per line.
config_problems() {
  local role=$1 unit=polkadot-$1.service key var name
  role_row "$role"
  local needed=("$CHAIN_VAR")
  [ "$role" = validator ] || needed+=(RELAY_CHAIN)
  [ -r "$CONF_DIR/metanode.env" ] || echo "$CONF_DIR/metanode.env is missing or unreadable; run install.sh --network NAME"
  for var in "${needed[@]}"; do
    case "${VARS[$var]:-}" in
      /*) [ -r "${VARS[$var]}" ] || echo "$var: the chain spec ${VARS[$var]} is not readable" ;;
    esac
    [ -n "${VARS[$var]+set}" ] || echo "$var: is not set; install.sh --network NAME sets it"
  done
  for key in "${!VARS[@]}"; do
    case "$key" in
      RELAY_CHAIN | ASSET_HUB_CHAIN | PEOPLE_CHAIN)
        [[ " ${needed[*]} " == *" $key "* ]] || continue
        ;;
    esac
    check_value "$key" "${VARS[$key]}" | sed "s/^/$key: /"
  done
  name=${VARS[NODE_NAME]:-}-$role
  # Substrate refuses node names of 64 characters or more.
  ((${#name} < 64)) || echo "NODE_NAME: the node name $name is 64 characters or longer"
  extra_args_problems "$unit" node EXTRA_ARGS
  [ "$role" = validator ] || extra_args_problems "$unit" relay RELAY_EXTRA_ARGS
}

# check_config <file>: checks a metanode.env on its own, for install.sh: its syntax, and the values of
# its variables. The chain specs need not be installed yet.
check_config() {
  local file=$1 problems key unknown
  [ -r "$file" ] || die "cannot read $file"
  VARS=()
  load_env_file "$file"
  problems=$(
    env_file_errors "$file"
    for key in RELAY_CHAIN ASSET_HUB_CHAIN PEOPLE_CHAIN; do
      [ -n "${VARS[$key]+set}" ] || echo "$key: is not set; install.sh --network NAME sets it"
    done
    for key in "${!VARS[@]}"; do
      check_value "$key" "${VARS[$key]}" | sed "s/^/$key: /"
    done
  )
  unknown=$(unknown_variables | tr '\n' ' ')
  [ -z "$unknown" ] || warn "$file: no unit uses ${unknown% } (a typo?)"
  if [ -n "$problems" ]; then
    echo "polkadot-metanodectl: $file:" >&2
    while IFS= read -r key; do echo "  $key"; done <<<"$problems" >&2
    exit "$EX_CONFIG"
  fi
}

# The genesis hash the chain of a part must have, if known: the network table's, when VARS select
# the chain the table gives their NETWORK. A chain of your own (CHAIN set to another id or spec) has
# none.
expected_genesis() {
  local var net
  var=$(part_var "$1")
  net=$(network_chain "${VARS[NETWORK]:-}" "$1") || return 0
  if [ "${VARS[$var]:-}" = "${net% *}" ]; then echo "${net#* }"; fi
}

# ---- nodes --------------------------------------------------------------------------------------

# The http(s) form of a ws(s) URL: the node serves HTTP JSON-RPC and /health on the same port.
http_url() {
  local url=${1/#ws:/http:}
  url=${url/#wss:/https:}
  echo "${url%/}"
}

# The genesis hash a relay-chain RPC endpoint serves, or nothing if it does not answer.
url_genesis() {
  curl -fsS -m 5 -H 'Content-Type: application/json' \
    -d '{"id":1,"jsonrpc":"2.0","method":"chain_getBlockHash","params":[0]}' "$(http_url "$1")" 2>/dev/null |
    sed -n 's/.*"result":"\(0x[0-9a-f]*\)".*/\1/p'
}

# The X.Y.Z of a binary's --version, as the node compares it with its workers' (empty if none).
version_of() {
  local out
  out=$("$1" --version 2>/dev/null) || return 0
  if [[ "$out" =~ ([0-9]+\.[0-9]+\.[0-9]+) ]]; then echo "${BASH_REMATCH[1]}"; fi
}

# The directory of the validator's PVF workers: its unit's --workers-path.
workers_dir() {
  systemctl show -p ExecStart --value polkadot-validator.service 2>/dev/null |
    grep -o -- '--workers-path=[^ ;]*' | head -n 1 | cut -d= -f2 || true
}

# The validator's PVF workers must exist and be of the node's version, or the node stops at its first
# PVF job.
workers_problems() {
  local dir worker node_version worker_version
  dir=$(workers_dir)
  [ -n "$dir" ] || { echo "polkadot-validator.service passes no --workers-path"; return; }
  node_version=$(version_of "$BIN_DIR/polkadot")
  for worker in polkadot-prepare-worker polkadot-execute-worker; do
    if [ ! -x "$dir/$worker" ]; then
      echo "$dir/$worker not found or not executable"
      continue
    fi
    worker_version=$(version_of "$dir/$worker")
    [ "$worker_version" = "$node_version" ] ||
      echo "$dir/$worker is version ${worker_version:-unknown} but $BIN_DIR/polkadot is ${node_version:-unknown}"
  done
}

# JSON-RPC call to a role's localhost endpoint (the unsafe one, which always listens on localhost).
rpc() {
  local port=$1 method=$2 params=$3
  curl -fsS -m 30 -H 'Content-Type: application/json' \
    -d "{\"id\":1,\"jsonrpc\":\"2.0\",\"method\":\"$method\",\"params\":$params}" \
    "http://127.0.0.1:$port"
}

# Accepts a stash as an SS58 address or a 0x-prefixed 32-byte account id and prints the hex form
# that author_rotateKeysWithOwner expects.
account_hex() {
  local stash=$1
  if [[ "$stash" =~ ^0x[0-9a-fA-F]{64}$ ]]; then
    echo "$stash"
    return
  fi
  local hex
  hex=$("$BIN_DIR/polkadot" key inspect "$stash" 2>/dev/null | awk '/Account ID:/ { print $3 }') || true
  [[ "$hex" =~ ^0x[0-9a-fA-F]{64}$ ]] || die "'$stash' is not an SS58 address or a 0x-prefixed account id"
  echo "$hex"
}

rotate_keys() {
  role_row "$1"
  local stash=$2 owner response keys proof
  owner=$(account_hex "$stash")
  response=$(rpc "$RPC_UNSAFE_PORT" author_rotateKeysWithOwner "[\"$owner\"]") ||
    die "cannot reach the $ROLE RPC on 127.0.0.1:$RPC_UNSAFE_PORT; is polkadot-$ROLE running?"
  if jq -e '.error' >/dev/null <<<"$response"; then
    die "author_rotateKeysWithOwner failed: $(jq -c '.error' <<<"$response")"
  fi
  keys=$(jq -r '.result.keys' <<<"$response")
  proof=$(jq -r '.result.proof' <<<"$response")
  echo "keys:  $keys"
  echo "proof: $proof"
  if [ "$ROLE" = validator ]; then
    echo "Submit both with stakingRcClient.setKeys(keys, proof) on Asset Hub, signed by the stash" \
      "or its staking operator proxy."
  else
    echo "Submit both with session.setKeys(keys, proof) on the ${ROLE%-collator} chain, signed by $stash."
  fi
}

# Prints the block number of a chain_getHeader response, or "-" if there is none.
block_number() {
  local hex
  hex=$(jq -r '.result.number // empty' <<<"$1" 2>/dev/null) || true
  if [[ "$hex" =~ ^0x[0-9a-fA-F]+$ ]]; then
    echo $((hex))
  else
    echo -
  fi
}

# The genesis column of status and doctor: ok, MISMATCH or - (not checked).
genesis_state() {
  local port=$1 expected=${2:-} got
  [ -n "$expected" ] || { echo -; return; }
  got=$(rpc "$port" chain_getBlockHash '[0]' 2>/dev/null | jq -r '.result // empty') || true
  if [ -z "$got" ]; then
    echo -
  elif [ "$got" = "$expected" ]; then
    echo ok
  else
    echo MISMATCH
  fi
}

# Queries one role's localhost RPC and prints "peers syncing best finalized genesis peer-id". Any
# failure (e.g. the node stopping mid-way) degrades to "-" fields instead of aborting the table.
role_health() {
  local port=$1 expected=${2:-} health head
  health=$(rpc "$port" system_health '[]' 2>/dev/null) || {
    echo "- - - - - -"
    return
  }
  head=$(rpc "$port" chain_getFinalizedHead '[]' 2>/dev/null | jq -r '.result // empty') || true
  echo "$(jq -r '.result.peers' <<<"$health") $(jq -r '.result.isSyncing' <<<"$health")" \
    "$(block_number "$(rpc "$port" chain_getHeader '[]' 2>/dev/null || true)")" \
    "$(block_number "$(rpc "$port" chain_getHeader "[\"$head\"]" 2>/dev/null || true)")" \
    "$(genesis_state "$port" "$expected")" \
    "$(rpc "$port" system_localPeerId '[]' 2>/dev/null | jq -r '.result // "-"' || echo -)"
}

status() {
  local format='%-18s %-9s %-11s %5s %-7s %9s %9s %-8s %s\n'
  # shellcheck disable=SC2059 # the format string is a local constant
  printf "$format" ROLE ENABLED ACTIVE PEERS SYNCING BEST FINALIZED GENESIS PEER-ID
  local role unit enabled active fields
  for role in "${ROLES[@]}"; do
    unit=polkadot-$role.service
    systemctl cat "$unit" >/dev/null 2>&1 || continue
    enabled=$(systemctl is-enabled "$unit" 2>/dev/null) || true
    active=$(systemctl is-active "$unit" 2>/dev/null) || true
    fields="- - - - - -"
    if [ "$active" = active ]; then
      role_row "$role"
      load_role_env "$role"
      fields=$(role_health "$RPC_UNSAFE_PORT" "$(expected_genesis "$(role_part "$role")")")
    fi
    # shellcheck disable=SC2059,SC2086 # word-splitting $fields into the six columns is intended
    printf "$format" "$role" "${enabled:--}" "${active:--}" $fields
  done
}

# ---- bandwidth reservation (operators/bandwidth.md) ---------------------------------------------

# Settings of the HTB tree: the validator is guaranteed VALIDATOR_UPLINK_MBIT, everything else the
# rest; whatever one class leaves idle the other may borrow. The tree is shaped at SHAPE_PERCENT of
# the committed rate, so the queue builds here, where HTB orders it, and not at the provider.
QOS_SHAPE_PERCENT=95
# Each class may send 1 ms of its own rate back to back (its burst), and 1 ms of the shaped rate when
# it borrows (its cburst), so the classes together never send more than 1 ms of the shaped rate at
# once. Much less makes HTB pause a class after almost every packet and miss its rate at gigabit
# speeds.
QOS_BURST_US=1000
# The single machine minimum of hardware.md: a lower rate only gets a warning.
QOS_MIN_RATE_MBIT=1000
QOS_TABLE=polkadot_metanode_qos

# The reservation's settings, from metanode.env.
load_qos_settings() {
  VARS=()
  if [ -r "$CONF_DIR/metanode.env" ]; then load_env_file "$CONF_DIR/metanode.env"; fi
  UPLINK_RATE=${VARS[UPLINK_RATE]:-}
  UPLINK_DEVICE=${VARS[UPLINK_DEVICE]:-}
  VALIDATOR_UPLINK_MBIT=${VARS[VALIDATOR_UPLINK_MBIT]:-500}
}

# qos_kernel_affected [release]: CVE-2026-53079. From Linux 6.19 to 7.0.9, fq_codel under HTB leaks
# every packet it drops, and TCP flows through a saturated class then freeze (verified on Ubuntu
# 26.04's 7.0.0-27). Fixed in 7.0.10 and 7.1, and in Ubuntu's 7.0.0-28, which keeps the 7.0.0
# version and counts its own releases in the ABI number.
qos_kernel_affected() {
  local release=${1:-$(uname -r)} minor patch abi
  [[ "$release" =~ ^([0-9]+\.[0-9]+)(\.([0-9]+))?(-([0-9]+))? ]] || return 1
  minor=${BASH_REMATCH[1]} patch=${BASH_REMATCH[3]:-0} abi=${BASH_REMATCH[5]:-}
  [ "$minor" = 6.19 ] && return 0
  [ "$minor" = 7.0 ] && ((patch < 10)) || return 1
  if [ "$patch" = 0 ] && [ -n "$abi" ] && ((abi >= 28)); then return 1; fi
  return 0
}

# The interfaces of the default routes, IPv4 and IPv6, each once.
qos_route_devices() {
  local family
  for family in -4 -6; do
    ip "$family" route show default 2>/dev/null
  done | awk '{ for (i = 1; i < NF; i++) if ($i == "dev" && !seen[$(i + 1)]++) print $(i + 1) }'
}

# The interface to shape: UPLINK_DEVICE, else the interface of the default routes. With several,
# shaping one of them would leave the validator's traffic through the others without a guarantee,
# so it is not guessed.
qos_device() {
  if [ -n "$UPLINK_DEVICE" ]; then
    echo "$UPLINK_DEVICE"
    return
  fi
  local devices
  devices=$(qos_route_devices)
  [ -n "$devices" ] || die "no default route found; set UPLINK_DEVICE to the uplink interface"
  [ "$(wc -l <<<"$devices")" = 1 ] || die "the default routes use more than one interface" \
    "($(tr '\n' ' ' <<<"$devices" | sed 's/ $//')); set UPLINK_DEVICE to the one to shape"
  echo "$devices"
}

# Whether the root of <device> is the tree that qos start builds.
qos_tree_is_ours() {
  local root
  root=$(tc qdisc show dev "$1" root 2>/dev/null) || return 1
  [[ "$root" =~ ^qdisc\ htb\ 1:\ root\ .*\ default\ (0x)?20\  ]]
}

# Prints a rate such as 1gbit, 2.5gbit or 1000mbit in Mbit/s, or fails.
qos_mbit() {
  echo "$1" | awk '{
    r = tolower($0)
    if (r !~ /^[0-9]+(\.[0-9]+)?(mbit|gbit)$/) exit 1
    n = r + 0
    if (r ~ /gbit$/) n *= 1000
    printf "%d\n", n
  }'
}

# Loads the nft table that puts the validator's packets, PVF workers included, in class 1:10.
# Loading replaces the table, so it can be repeated.
qos_table() {
  nft -f - <<EOF
table inet $QOS_TABLE
delete table inet $QOS_TABLE
table inet $QOS_TABLE {
	chain egress {
		type filter hook output priority mangle; policy accept;
		meta skuid "$VALIDATOR_USER" meta priority set 1:10
	}
}
EOF
}

qos() {
  load_qos_settings
  local dev
  case "${1:-}" in
    check)
      [ -n "$UPLINK_RATE" ] || die "UPLINK_RATE is not set in $CONF_DIR/metanode.env"
      ! qos_kernel_affected || die "the bandwidth reservation is not supported on Linux $(uname -r)" \
        "(CVE-2026-53079: fq_codel under HTB freezes TCP flows on 6.19.x and 7.0.0 to 7.0.9);" \
        "upgrade the kernel"
      command -v tc >/dev/null || die "tc not found; install iproute2"
      command -v nft >/dev/null || die "nft not found; install nftables"
      qos_mbit "$UPLINK_RATE" >/dev/null ||
        die "UPLINK_RATE='$UPLINK_RATE' must look like 1gbit, 2.5gbit or 1000mbit"
      [[ "$VALIDATOR_UPLINK_MBIT" =~ ^[1-9][0-9]*$ ]] ||
        die "VALIDATOR_UPLINK_MBIT='$VALIDATOR_UPLINK_MBIT' is not a number of Mbit/s"
      dev=$(qos_device)
      ;;
    start)
      qos check
      id -u "$VALIDATOR_USER" >/dev/null 2>&1 || die "user $VALIDATOR_USER does not exist; run install.sh"
      dev=$(qos_device)
      local rate_mbit link_mbit other_mbit link_burst validator_burst other_burst
      rate_mbit=$(qos_mbit "$UPLINK_RATE")
      link_mbit=$((rate_mbit * QOS_SHAPE_PERCENT / 100))
      other_mbit=$((link_mbit - VALIDATOR_UPLINK_MBIT))
      # A class's burst is QOS_BURST_US of its rate, and its cburst QOS_BURST_US of its ceil, which is
      # LINK for every class. Mbit/s times microseconds is bits; / 8 gives bytes.
      link_burst=$((link_mbit * QOS_BURST_US / 8))
      validator_burst=$((VALIDATOR_UPLINK_MBIT * QOS_BURST_US / 8))
      other_burst=$((other_mbit * QOS_BURST_US / 8))
      ((other_mbit > 0)) || die "UPLINK_RATE=$UPLINK_RATE leaves nothing beyond the validator's" \
        "$VALIDATOR_UPLINK_MBIT Mbit/s"
      ((rate_mbit >= QOS_MIN_RATE_MBIT)) ||
        warn "UPLINK_RATE=$UPLINK_RATE is below the $QOS_MIN_RATE_MBIT Mbit/s single machine minimum"
      echo "polkadot-metanodectl: $dev: link ${link_mbit}mbit, validator ${VALIDATOR_UPLINK_MBIT}mbit," \
        "everything else ${other_mbit}mbit"
      # Keep our own running tree: HTB cannot replace an HTB root in place ("Change operation not
      # supported"), not even another one with handle 1:. Any other root goes first. The classes and
      # leaves below are replaced in place.
      if ! qos_tree_is_ours "$dev"; then
        tc qdisc del dev "$dev" root 2>/dev/null || true
        tc qdisc add dev "$dev" root handle 1: htb default 20
      fi
      # quantum 200000 is the kernel's maximum; HTB's default, the rate / 10, is above it here and
      # makes tc warn.
      tc class replace dev "$dev" parent 1: classid 1:1 htb rate "${link_mbit}mbit" \
        burst "$link_burst" cburst "$link_burst" quantum 200000
      tc class replace dev "$dev" parent 1:1 classid 1:10 htb rate "${VALIDATOR_UPLINK_MBIT}mbit" \
        ceil "${link_mbit}mbit" burst "$validator_burst" cburst "$link_burst" quantum 200000 prio 0
      tc class replace dev "$dev" parent 1:1 classid 1:20 htb rate "${other_mbit}mbit" \
        ceil "${link_mbit}mbit" burst "$other_burst" cburst "$link_burst" quantum 200000 prio 1
      tc qdisc replace dev "$dev" parent 1:10 handle 10: fq_codel
      tc qdisc replace dev "$dev" parent 1:20 handle 20: fq_codel
      qos_table
      ;;
    reload)
      # After the firewall replaced the ruleset (nftables.service starting or reloading runs `flush
      # ruleset`): the HTB tree is untouched, only the table that tags the validator is gone.
      if systemctl is-active --quiet polkadot-metanode-qos.service; then qos_table; fi
      ;;
    stop)
      nft delete table inet "$QOS_TABLE" 2>/dev/null || true
      # Our tree, wherever it is: on UPLINK_DEVICE, or on the default routes' interfaces, even if
      # they changed since it was built.
      for dev in ${UPLINK_DEVICE:-$(qos_route_devices)}; do
        if qos_tree_is_ours "$dev"; then tc qdisc del dev "$dev" root 2>/dev/null || true; fi
      done
      ;;
    status)
      dev=$(qos_device)
      tc -s class show dev "$dev"
      nft list table inet "$QOS_TABLE" 2>/dev/null || echo "nft table $QOS_TABLE is not loaded"
      ;;
    *) usage ;;
  esac
}

# ---- chain specs --------------------------------------------------------------------------------

# fetch-specs <network> <dir>: downloads the network's chain specs (none for networks whose specs are
# built in) into <dir> and checks each against its pinned sha256.
fetch_specs() {
  local network=$1 dir=$2 file url sha got
  valid_network "$network" || die "unknown network '$network' (expected one of: ${NETWORKS[*]})"
  while read -r file url sha; do
    [[ "$file" == "$network"/* ]] || continue
    mkdir -p "$dir/$(dirname "$file")"
    curl -fsSL --retry 3 -o "$dir/$file.download" "$url" || die "cannot download $url"
    got=$(sha256sum "$dir/$file.download" | cut -d' ' -f1)
    if [ "$got" != "$sha" ]; then
      rm -f "$dir/$file.download"
      die "$url has changed (sha256 $got, expected $sha). Check that it still is the $network" \
        "network the metanode runs (genesis in NETWORK_TABLE) before updating its sha256 in" \
        "CHAIN_SPEC_TABLE of polkadot-metanodectl."
    fi
    mv -f "$dir/$file.download" "$dir/$file"
    echo "$file"
  done <<<"$CHAIN_SPEC_TABLE"
}

# ---- doctor -------------------------------------------------------------------------------------

DOCTOR_FAILURES=0
DOCTOR_WARNINGS=0

report() {
  local level=$1
  shift
  printf '%-4s %s\n' "$level" "$*"
  case "$level" in
    FAIL) DOCTOR_FAILURES=$((DOCTOR_FAILURES + 1)) ;;
    WARN) DOCTOR_WARNINGS=$((DOCTOR_WARNINGS + 1)) ;;
  esac
}

# The roles doctor looks at by default: those enabled or running here, else all of them.
local_roles() {
  local role all
  all=$(systemctl is-enabled polkadot-metanode-all.target 2>/dev/null) || true
  for role in "${ROLES[@]}"; do
    if [ "$all" = enabled ] ||
      [ "$(systemctl is-enabled "polkadot-$role.service" 2>/dev/null)" = enabled ] ||
      systemctl is-active --quiet "polkadot-$role.service" 2>/dev/null; then
      echo "$role"
    fi
  done
}

# Whether <pid> runs in one of our units, so the port it holds is not a conflict.
ours() {
  local cgroup
  cgroup=$(cat "/proc/$1/cgroup" 2>/dev/null) || return 1
  [[ "$cgroup" == *polkadot-metanode.slice/polkadot-* ]]
}

# port_users <tcp|udp> <port>: the pids listening on it, one per line.
port_users() {
  local flag=-Htlnp
  [ "$1" = udp ] && flag=-Hulnp
  ss "$flag" "sport = :$2" 2>/dev/null | grep -o 'pid=[0-9]*' | cut -d= -f2 | sort -u || true
}

doctor() {
  local roles=() role
  for role in "$@"; do roles+=("$(canonical_role "$role")"); done
  if [ ${#roles[@]} -eq 0 ]; then mapfile -t roles < <(local_roles); fi
  [ ${#roles[@]} -gt 0 ] || roles=("${ROLES[@]}")
  for role in "${roles[@]}"; do role_row "$role"; done
  local has_validator=0
  [[ " ${roles[*]} " == *" validator "* ]] && has_validator=1
  echo "polkadot-metanodectl doctor: ${roles[*]}"
  [ "$(id -u)" = 0 ] || report WARN "not run as root: port owners and some checks may be incomplete"

  # Configuration: what each role's unit passes to its node.
  local out unknown
  for role in "${roles[@]}"; do
    load_role_env "$role"
    out=$(config_problems "$role")
    if [ -z "$out" ]; then
      report OK "configuration of $role"
    else
      report FAIL "configuration of $role: $(sed ':a;N;$!ba;s/\n/; /g' <<<"$out")"
    fi
    unknown=$(unknown_variables | tr '\n' ' ')
    [ -z "$unknown" ] || report WARN "configuration of $role: no unit uses ${unknown% } (a typo?)"
  done

  # Kernel and the PVF sandbox and workers of the validator.
  local release major minor
  release=$(uname -r)
  IFS=. read -r major minor _ <<<"$release"
  if ((major > 5 || (major == 5 && minor >= 16))); then
    report OK "kernel $release (5.16 or later)"
  else
    report FAIL "kernel $release: hardware.md requires Linux 5.16 or later"
  fi
  if [ "$has_validator" = 1 ]; then
    out=$(workers_problems)
    if [ -z "$out" ]; then
      report OK "PVF workers of version $(version_of "$BIN_DIR/polkadot") in $(workers_dir)"
    else
      report FAIL "PVF workers: $(sed ':a;N;$!ba;s/\n/; /g' <<<"$out")"
    fi
    if [ -r /proc/sys/kernel/seccomp/actions_avail ]; then
      report OK "seccomp available"
    else
      report FAIL "seccomp unavailable: the validator refuses to start without it"
    fi
    if grep -qw landlock /sys/kernel/security/lsm 2>/dev/null; then
      report OK "landlock enabled"
    else
      report WARN "landlock not enabled (add lsm=landlock,... to the kernel command line);" \
        "the validator then relies on the user-namespace sandbox"
    fi
    if [ "$(sysctl -n kernel.apparmor_restrict_unprivileged_userns 2>/dev/null)" = 1 ] &&
      [ ! -e /etc/apparmor.d/polkadot-pvf-workers ]; then
      report WARN "kernel.apparmor_restrict_unprivileged_userns=1: the PVF workers cannot use user" \
        "namespaces; install the AppArmor profile of README.md (Security notes)"
    fi
  fi

  # Time.
  local synced tracking
  synced=$(timedatectl show -p NTPSynchronized --value 2>/dev/null) || true
  tracking=$(chronyc -n tracking 2>/dev/null) || true
  if [ "$synced" = yes ]; then
    report OK "clock synchronised (NTP)"
  elif grep -q 'Leap status *: Normal' <<<"$tracking"; then
    report OK "clock synchronised (chrony)"
  else
    report WARN "clock not synchronised: install and enable an NTP client (chrony or systemd-timesyncd)"
  fi

  # Hardware, against hardware.md: per service, and the single machine requirements for all three.
  local cores=0 mem_gb disk_gb need_cores=0 need_mem=0 need_disk=0 threads
  for role in "${roles[@]}"; do
    case "$role" in
      validator) need_cores=$((need_cores + 8)) need_mem=$((need_mem + 32)) need_disk=$((need_disk + 2000)) ;;
      *) need_cores=$((need_cores + 4)) need_mem=$((need_mem + 32)) need_disk=$((need_disk + 200)) ;;
    esac
  done
  if [ ${#roles[@]} -eq 3 ]; then need_cores=16 need_mem=64 need_disk=2400; fi
  ((need_mem <= 64)) || need_mem=64
  cores=$(lscpu -p=core,socket 2>/dev/null | grep -v '^#' | sort -u | wc -l) || cores=0
  threads=$(nproc)
  if ((cores >= need_cores)); then
    report OK "$cores physical cores (needs $need_cores)"
  else
    report WARN "$cores physical cores, hardware.md asks for $need_cores for ${roles[*]}"
  fi
  if [ "$has_validator" = 1 ] && ((cores > 0 && threads > cores)); then
    report WARN "SMT (hyper-threading) is on: hardware.md recommends disabling it for validators"
  fi
  mem_gb=$(awk '/^MemTotal:/ { printf "%d", $2 / 1000000 }' /proc/meminfo)
  if ((mem_gb >= need_mem)); then
    report OK "${mem_gb} GB of memory (needs $need_mem)"
  else
    report WARN "${mem_gb} GB of memory, hardware.md asks for $need_mem GB for ${roles[*]}"
  fi
  disk_gb=$(df -P -BG /var/lib 2>/dev/null | awk 'NR == 2 { sub(/G$/, "", $2); print $2 }') || disk_gb=0
  if ((disk_gb >= need_disk)); then
    report OK "/var/lib is on a ${disk_gb} GB filesystem (needs $need_disk)"
  else
    report WARN "/var/lib is on a ${disk_gb} GB filesystem, hardware.md asks for $need_disk GB for ${roles[*]}"
  fi

  # Ports: free, or held by our own units. An embedded relay chain node also serves RPC.
  local proto port pid busy check
  for role in "${roles[@]}"; do
    role_row "$role"
    load_role_env "$role"
    busy=()
    local checks=("tcp $P2P_PORT" "udp $P2P_PORT" "tcp $RPC_PORT" "tcp $RPC_UNSAFE_PORT" "tcp $PROMETHEUS_PORT")
    [ "$role" = validator ] || checks+=("tcp $RELAY_P2P_PORT" "tcp $RELAY_PROMETHEUS_PORT")
    [ "$role" = validator ] || [ -n "${VARS[RELAY_CHAIN_RPC_URLS]:-}" ] || checks+=("tcp $RELAY_RPC_PORT")
    for check in "${checks[@]}"; do
      read -r proto port <<<"$check"
      for pid in $(port_users "$proto" "$port"); do
        ours "$pid" || busy+=("$proto/$port ($(ps -o comm= -p "$pid" 2>/dev/null || echo "pid $pid"))")
      done
    done
    if [ ${#busy[@]} -eq 0 ]; then
      report OK "ports of $role free or in use by it"
    else
      report FAIL "ports of $role taken by other programs: ${busy[*]}"
    fi
  done

  # Public addresses, as the role's public-addr step resolves PUBLIC_IP when it starts (the p2p ports
  # must be open and, behind NAT, forwarded).
  local addrs messages
  for role in "${roles[@]}"; do
    role_row "$role"
    load_role_env "$role"
    if [ ! -x "$LIB_DIR/public-addr" ]; then
      report FAIL "$LIB_DIR/public-addr not found; run install.sh"
      break
    fi
    # Its PUBLIC_ADDRS line on stdout, and what it would log, prefixed "public-addr: ".
    out=$(PUBLIC_IP=${VARS[PUBLIC_IP]:-auto} RUNTIME_DIRECTORY='' "$LIB_DIR/public-addr" "$P2P_PORT" 2>&1) || true
    addrs=$(grep -o '/ip[46]/[^/]*/tcp/' <<<"$out" | cut -d/ -f3 | tr '\n' ' ') || true
    messages=$(grep '^public-addr: ' <<<"$out" | grep -v '^public-addr: advertising' | sed 's/^public-addr: //') || true
    if [ -n "$addrs" ]; then
      report OK "$role advertises ${addrs% } (open port $P2P_PORT, TCP and UDP)"
    elif [ "${VARS[PUBLIC_IP]:-auto}" = none ]; then
      report WARN "$role: PUBLIC_IP=none, so light clients may not reach it over WebRTC"
    else
      report WARN "$role advertises no public address${messages:+: $messages}"
    fi
  done

  # The collators' relay chain RPC endpoints must all serve the relay chain: the network's, when
  # RELAY_CHAIN is the network's own, else the validator's on this machine, else that of the first
  # one that answers. A fallback of another network (Paseo has several) would feed the collator
  # another chain's blocks once it fails over. Then the genesis of every running role.
  local url genesis expected reference validator_rpc
  role_row validator
  validator_rpc=$RPC_UNSAFE_PORT
  for role in "${roles[@]}"; do
    role_row "$role"
    load_role_env "$role"
    if [ "$role" != validator ]; then
      if [ -z "${VARS[RELAY_CHAIN_RPC_URLS]:-}" ]; then
        report OK "$role runs its own relay chain node (RELAY_CHAIN_RPC_URLS is empty)"
      else
        expected=$(expected_genesis relay) reference="the ${VARS[NETWORK]:-} relay chain"
        if [ -z "$expected" ] && systemctl is-active --quiet polkadot-validator.service 2>/dev/null; then
          expected=$(rpc "$validator_rpc" chain_getBlockHash '[0]' 2>/dev/null | jq -r '.result // empty') || true
          reference="the validator on this machine"
        fi
        for url in ${VARS[RELAY_CHAIN_RPC_URLS]}; do
          genesis=$(url_genesis "$url") || true
          if [ -z "$genesis" ]; then
            report WARN "$role: relay-chain RPC $url does not answer"
          elif [ -z "$expected" ]; then
            expected=$genesis reference=$url
            report OK "$role: relay-chain RPC $url answers"
          elif [ "$genesis" != "$expected" ]; then
            report FAIL "$role: relay-chain RPC $url serves another chain (genesis $genesis) than $reference ($expected)"
          else
            report OK "$role: relay-chain RPC $url answers, with the genesis of $reference"
          fi
        done
      fi
    fi
    if systemctl is-active --quiet "polkadot-$role.service" 2>/dev/null; then
      expected=$(expected_genesis "$(role_part "$role")")
      case $(genesis_state "$RPC_UNSAFE_PORT" "$expected") in
        ok) report OK "$role runs the ${VARS[NETWORK]:-} chain (genesis matches)" ;;
        MISMATCH) report FAIL "$role runs another chain than expected (genesis $expected)" ;;
        *) report OK "$role is running (genesis not checked)" ;;
      esac
    fi
  done

  # Sharing the uplink (bandwidth.md).
  load_qos_settings
  if [ -n "$UPLINK_RATE" ]; then
    if out=$("$0" qos check 2>&1); then
      report OK "bandwidth reservation possible (UPLINK_RATE=$UPLINK_RATE)"
    else
      report FAIL "bandwidth reservation: ${out#polkadot-metanodectl: }"
    fi
    if systemctl is-active --quiet polkadot-metanode-qos.service 2>/dev/null; then
      report OK "polkadot-metanode-qos.service is active"
    else
      report WARN "polkadot-metanode-qos.service is not active: run install.sh again or start it"
    fi
  elif [ "$has_validator" = 1 ] && [ ${#roles[@]} -gt 1 ]; then
    report WARN "the validator shares this machine but no bandwidth is reserved for it: set" \
      "UPLINK_RATE (bandwidth.md), unless its uplink is above 10 Gbit/s"
  fi

  if command -v needrestart >/dev/null; then
    report WARN "needrestart is installed: library upgrades (unattended-upgrades) restart the roles" \
      "that use them; see README.md (Operate)"
  fi

  echo "polkadot-metanodectl doctor: $DOCTOR_FAILURES failed, $DOCTOR_WARNINGS warnings"
  [ "$DOCTOR_FAILURES" = 0 ]
}

main() {
  case "${1:-}" in
    status)
      [ $# -eq 1 ] || usage
      status
      ;;
    doctor)
      shift
      doctor "$@"
      ;;
    rotate-keys)
      [ $# -eq 3 ] || usage
      rotate_keys "$2" "$3"
      ;;
    qos)
      [ $# -eq 2 ] || usage
      qos "$2"
      ;;
    network-env)
      [ $# -eq 2 ] || usage
      network_env "$2"
      ;;
    check-config)
      [ $# -eq 2 ] || usage
      check_config "$2"
      ;;
    fetch-specs)
      [ $# -eq 3 ] || usage
      fetch_specs "$2" "$3"
      ;;
    -h | --help | help) usage 0 ;;
    *) usage ;;
  esac
}

main "$@"
