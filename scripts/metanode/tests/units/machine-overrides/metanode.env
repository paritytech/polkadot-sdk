# One metanode over two machines: the collators read the relay chain from the validator's private
# address. Each role's own file overrides this one for this machine.
NETWORK=polkadot
RELAY_CHAIN=polkadot
ASSET_HUB_CHAIN=asset-hub-polkadot
PEOPLE_CHAIN=people-polkadot
NODE_NAME=fleet
RELAY_CHAIN_RPC_URLS=ws://10.0.0.5:9944
