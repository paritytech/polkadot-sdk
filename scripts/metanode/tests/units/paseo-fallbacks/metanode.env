# Paseo's downloaded specs, and public fallbacks after the local validator. Quotes and the whitespace
# around "=" and values are read as systemd reads them.
NETWORK=paseo
RELAY_CHAIN=/usr/local/lib/polkadot-metanode/chain-specs/paseo/paseo.json
ASSET_HUB_CHAIN = /usr/local/lib/polkadot-metanode/chain-specs/paseo/asset-hub-next-paseo.json
PEOPLE_CHAIN='/usr/local/lib/polkadot-metanode/chain-specs/paseo/people-next-paseo.json'
RELAY_CHAIN_RPC_URLS="ws://127.0.0.1:9944 wss://paseo-rpc.n.dwellir.com wss://pas-rpc.stakeworld.io"
NODE_NAME=acme-4
