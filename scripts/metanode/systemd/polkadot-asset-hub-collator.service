# The Asset Hub collator of operators/setup.md. ExecStart is setup.md's command, plus:
# - --authoring=slot-based, which runtimes with a relay-parent offset need;
# - --sync=${SYNC}, warp by default: setup.md full syncs, which took People more than five hours;
# - the public addresses of PUBLIC_IP for TCP as well as WebRTC, on IPv4 and IPv6;
# - after "--", the settings of an embedded relay chain node (--rpc-port to the end), which only
#   runs with RELAY_CHAIN_RPC_URLS empty. setup.md's relay chain node reads the validator's RPC and
#   ignores them.
#
# Variables work as in polkadot-validator.service; this machine's own file is
# /etc/polkadot-metanode/polkadot-asset-hub-collator.env. See scripts/metanode/README.md, "Configure".
[Unit]
Description=Metanode Asset Hub collator
Documentation=https://github.com/paritytech/polkadot-sdk/tree/master/scripts/metanode
# Ordering only: a collator-only machine has no validator unit to wait for.
After=polkadot-validator.service

[Service]
User=polkadot-asset-hub-collator
Group=polkadot-asset-hub-collator
StateDirectory=polkadot-asset-hub-collator
RuntimeDirectory=polkadot-asset-hub-collator
WorkingDirectory=/var/lib/polkadot-asset-hub-collator
SyslogIdentifier=polkadot-asset-hub-collator
Environment=NODE_NAME=%l RPC_LISTEN_IP=127.0.0.1 RPC_MAX_CONNECTIONS=200 SYNC=warp
Environment=RELAY_CHAIN_RPC_URLS=ws://127.0.0.1:9944 EXTRA_ARGS= RELAY_EXTRA_ARGS= PUBLIC_ADDRS=
EnvironmentFile=/etc/polkadot-metanode/metanode.env
EnvironmentFile=-/etc/polkadot-metanode/polkadot-asset-hub-collator.env
# PUBLIC_ADDRS, written by public-addr below.
EnvironmentFile=-/run/polkadot-asset-hub-collator/public-addr.env
ExecStartPre=/bin/sh -c 'test -s node.key || { @BINDIR@/polkadot-parachain key generate-node-key --file node.key.new && mv node.key.new node.key; }'
ExecStartPre=-+@LIBDIR@/public-addr 30334
ExecStart=@BINDIR@/polkadot-parachain --collator \
    --chain=${ASSET_HUB_CHAIN} \
    --name=${NODE_NAME}-asset-hub-collator \
    --base-path=/var/lib/polkadot-asset-hub-collator \
    --node-key-file=/var/lib/polkadot-asset-hub-collator/node.key \
    --authoring=slot-based \
    --port=30334 \
    --prometheus-port=9616 \
    --force-enable-webrtc $PUBLIC_ADDRS \
    --experimental-rpc-endpoint=listen-addr=${RPC_LISTEN_IP}:9946,methods=safe,max-connections=${RPC_MAX_CONNECTIONS} \
    --experimental-rpc-endpoint=listen-addr=127.0.0.1:9947,methods=unsafe,cors=http://localhost:9947 \
    --database=paritydb \
    --state-pruning=256 \
    --blocks-pruning=256 \
    --sync=${SYNC} \
    $EXTRA_ARGS \
    --relay-chain-rpc-urls $RELAY_CHAIN_RPC_URLS \
    -- \
    --chain=${RELAY_CHAIN} \
    --port=30335 \
    --prometheus-port=9617 \
    --rpc-port=9950 \
    --database=paritydb \
    --state-pruning=256 \
    --blocks-pruning=256 \
    --pool-limit=0 \
    $RELAY_EXTRA_ARGS
RestartSec=10
# No memory limit: a warp sync of Asset Hub peaks at about 25 GiB.

# Collators run no PVF workers, so they get no namespaces and no mount syscalls.
RestrictNamespaces=true
SystemCallFilter=@system-service
SystemCallFilter=~@clock @module @reboot @swap @privileged

[Install]
WantedBy=polkadot-metanode.target
